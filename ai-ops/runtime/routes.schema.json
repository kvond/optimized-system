{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Explicit provider-neutral route configuration",
 "type":"object","additionalProperties":false,
 "required":["version","routes"],
 "properties":{
  "version":{"type":"string","minLength":1},
  "routes":{"type":"array","items":{
   "type":"object","additionalProperties":false,
   "required":["name","provider","capability","estimated_cost","privacy_partitions","deterministic","enabled"],
   "properties":{
    "name":{"type":"string","minLength":1},
    "provider":{"type":"string","minLength":1},
    "capability":{"type":"integer","minimum":0},
    "estimated_cost":{"type":"string","pattern":"^(0|[1-9][0-9]*)(\\.[0-9]{1,6})?$"},
    "privacy_partitions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "deterministic":{"type":"boolean"},
    "enabled":{"type":"boolean"}
   }
  }}
 }
}
